{
  "_about": "Troca direta das formas de declaração. {name}, {binds}, {body} e {end} são preenchidos pelo pattern escolhido.",
  "def": "fn",
  "async def": "fn",
  "function": "fn {name}(__args: Args) -> Object {{\n{binds}{body}{end}\n}}",
  "typed function": "fn {name}({params}) -> {ret} {{\n{binds}{body}{end}\n}}",
  "typed adapter": "fn {name}__call(__args: Args) -> Object {{\n    Object::from({name}({converted}))\n}}",
  "coroutine body": "object::coroutine(move || {{\n{body}Object::None\n}})",
  "generator body": "object::generator(move |__yield| {{\n{body}Object::None\n}})",
  "lambda": "object::func(\"<lambda>\", {{ {captures} move |__args: Args| -> Object {{ {inner_captures}{binds}{body} }} }})",
  "nested def": "object::func({qualname:?}, {{ {captures} move |__args: Args| -> Object {{\n{inner_captures}{binds}{body}\n}} }})",
  "parameter": "let mut {local} = __args.bind({index}, {name:?}, {default});",
  "parameter *args": "let mut {local} = __args.rest({index});",
  "parameter **kwargs": "let mut {local} = __args.rest_kw(&[{declared}]);",
  "local": "let mut {local} = Object::Unbound;",
  "typed parameter": "let mut {local} = Object::from({arg});",
  "test wrapper": "#[test]\nfn {name}() {{\n    object::run_test(&[&vectora_test_support::TABLE, &LOCAL], {label:?}, || {{\n{setup}        {call}\n    }});\n}}",
  "class": "classes::class({name:?}, vec![{bases}], vec![{attrs}])",
  "module class": "fn {name}() -> Object {{\n    static VALUE: std::sync::OnceLock<Object> = std::sync::OnceLock::new();\n    VALUE.get_or_init(|| {value}).clone()\n}}",
  "decorator property": "classes::property({0})",
  "decorator staticmethod": "classes::staticmethod({0})",
  "decorator classmethod": "classes::classmethod({0})",
  "cell": "{local} = object::cell({local}.clone());",
  "cell read": "object::cell_get(&{local}, {name:?})",
  "cell write": "object::cell_set(&{local}, {value});",
  "super": "classes::super_(&{receiver}, {class})",
  "decorator": "object::call(&{decorator}, Args::new(vec![{value}], vec![]))"
}
